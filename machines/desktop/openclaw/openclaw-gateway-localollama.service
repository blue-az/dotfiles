[Unit]
Description=OpenClaw Gateway (profile: localollama, v2026.4.5)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/home/blueaz/.openclaw/tools/node-v22.22.0/bin/node /home/blueaz/.openclaw/lib/node_modules/openclaw/dist/entry.js gateway --port 18789
Restart=always
RestartSec=5
TimeoutStopSec=30
TimeoutStartSec=30
SuccessExitStatus=0 143
KillMode=control-group
Environment=HOME=/home/blueaz
Environment=TMPDIR=/tmp
Environment=OPENCLAW_STATE_DIR=/home/blueaz/.openclaw-localollama
Environment=OPENCLAW_CONFIG_PATH=/home/blueaz/.openclaw-localollama/openclaw.json
Environment=PATH=/home/blueaz/.openclaw/tools/node-v22.22.0/bin:/home/blueaz/.local/bin:/home/blueaz/.npm-global/bin:/home/blueaz/bin:/home/blueaz/.volta/bin:/home/blueaz/.asdf/shims:/home/blueaz/.bun/bin:/home/blueaz/.nvm/current/bin:/home/blueaz/.fnm/current/bin:/home/blueaz/.local/share/pnpm:/usr/local/bin:/usr/bin:/bin
Environment=OPENCLAW_PROFILE=localollama
Environment=OPENCLAW_GATEWAY_PORT=18789
Environment=OPENCLAW_SYSTEMD_UNIT=openclaw-gateway-localollama.service
Environment="OPENCLAW_WINDOWS_TASK_NAME=OpenClaw Gateway (localollama)"
Environment=OPENCLAW_SERVICE_MARKER=openclaw
Environment=OPENCLAW_SERVICE_KIND=gateway
Environment=OPENCLAW_SERVICE_VERSION=2026.4.5

[Install]
WantedBy=default.target
