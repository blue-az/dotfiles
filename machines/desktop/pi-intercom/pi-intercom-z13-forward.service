[Unit]
Description=Forward z13 pi-intercom socket to Desktop broker
[Service]
Type=simple
ExecStart=/usr/bin/ssh -N \
  -o BatchMode=yes \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  -o StreamLocalBindUnlink=yes \
  -R /home/blueaz/.pi/agent/intercom/broker.sock:/home/blueaz/.pi/agent/intercom/broker.sock \
  z13
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
