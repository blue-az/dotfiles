[Unit]
Description=Forward z13 pi-intercom socket to Desktop broker

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o IdentityFile=/home/blueaz/.ssh/id_ed25519_pi_intercom_z13 -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StreamLocalBindUnlink=yes -R /home/blueaz/.pi/agent/intercom/broker.sock:/home/blueaz/.pi/agent/intercom/broker.sock z13
Restart=always
RestartSec=10
RestartSteps=6
RestartMaxDelaySec=15min

[Install]
WantedBy=default.target
