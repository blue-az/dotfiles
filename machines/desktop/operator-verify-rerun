#!/usr/bin/env bash
# operator-verify-rerun — the one command uid-971 is permitted to run.
#
# Deterministic re-verification. Reads a review-delegate bundle, executes the
# verify_cmd that bundle pins, and reports the real exit code. No model, no
# credentials, no judgment.
#
#   sudo -u uid-971 operator-verify-rerun <bundle.yaml>
#
# WHAT THIS DEFENDS AGAINST
# The caller chooses which bundle to re-run. It cannot choose the verdict: the
# command comes from the bundle, the exit code comes from the kernel, and this
# script never accepts a status argument. An agent running as the claim author
# therefore cannot manufacture a uid_isolated "verified" by asking for one.
#
# WHAT IT DOES NOT DEFEND AGAINST
# A vacuous gate. If the claim's verify_cmd is `true` or a test that asserts
# nothing, this will faithfully report success. That limitation is already named
# in the repo README ("structural validity is not semantic truth") and is not
# made worse here. Re-running a bad gate honestly is still the job.
#
# It also does not defend against the human operator, who is the trust root and
# can sudo anywhere. The boundary is against an *agent* running as uid 1000.
set -euo pipefail

BUNDLE="${1:?usage: operator-verify-rerun <delegation-bundle.yaml>}"
[ -r "$BUNDLE" ] || { echo "cannot read bundle: $BUNDLE" >&2; exit 2; }

field() { python3 -c "
import sys,yaml
d=yaml.safe_load(open(sys.argv[1]))
v=d.get(sys.argv[2])
print('' if v is None else v)
" "$BUNDLE" "$1"; }

CLAIM=$(field claim_id)
REPO=$(field repo_root)
CMD=$(field verify_cmd)
TASK=$(field task_id)
AUTHOR_UID=$(python3 -c "
import sys,yaml
d=yaml.safe_load(open(sys.argv[1]))
print((d.get('author_executor') or {}).get('uid',''))
" "$BUNDLE")

[ -n "$CLAIM" ] || { echo "bundle has no claim_id" >&2; exit 2; }
[ -n "$CMD" ]   || { echo "claim $CLAIM has no verify_cmd; nothing to re-run" >&2; exit 2; }
[ -d "$REPO" ]  || { echo "repo_root does not exist: $REPO" >&2; exit 2; }

ME=$(id -u)
if [ "$ME" = "$AUTHOR_UID" ]; then
  echo "refusing: executing uid $ME is the claim author; this would not be uid_isolated" >&2
  exit 3
fi

# UID isolation and harness independence are different properties, and enforcing
# only the first produced a circular verification on claim-0115 (2026-08-30): a
# distinct uid running the harness that had built the task. Refuse when the
# registry name for this uid was issued a builder brief on this task.
MYNAME=$(python3 -c "
import sys,yaml
d=yaml.safe_load(open(sys.argv[1])) or {}
e=(d.get('uids') or {}).get(int(sys.argv[2])) or {}
print(e.get('name','') if isinstance(e,dict) else (e or ''))
" "$REPO/.operator/identity.yaml" "$ME" 2>/dev/null || true)

if [ -n "$MYNAME" ] && [ -n "$TASK" ]; then
  BRIEF="$REPO/.operator/briefs/$TASK.$MYNAME.export.md"
  if [ -e "$BRIEF" ]; then
    echo "refusing: '$MYNAME' was issued a builder brief for task $TASK" >&2
    echo "  ($BRIEF)" >&2
    echo "  A different uid is not a different reviewer if it runs the harness that built the work." >&2
    exit 4
  fi
fi

echo "claim:      $CLAIM"
echo "repo:       $REPO"
echo "verify_cmd: $CMD"
echo "running as: uid $ME ($(id -un 2>/dev/null || echo "uid-$ME")), author was uid $AUTHOR_UID"
echo "--- output ---"

set +e
OUT=$(cd "$REPO" && eval "$CMD" 2>&1)
RC=$?
set -e

printf '%s\n' "$OUT"
echo "--- exit: $RC ---"

# --- record the result in the ledger -------------------------------------
# The verifier identity is read from the ledger's own registry, keyed on the
# uid actually executing. Never from the bundle: a caller controls the bundle,
# and --verified-by must name the identity that really ran the gate.
VERIFIER=$(python3 -c "
import sys,yaml
d=yaml.safe_load(open(sys.argv[1])) or {}
e=(d.get('uids') or {}).get(int(sys.argv[2])) or {}
name=e.get('name') if isinstance(e,dict) else e
roles=e.get('roles',[]) if isinstance(e,dict) else []
print(name if (name and 'verifier' in roles) else '')
" "$REPO/.operator/identity.yaml" "$ME" 2>/dev/null || true)

if [ -z "$VERIFIER" ]; then
  echo "NOT RECORDED: uid $ME has no verifier role in $REPO/.operator/identity.yaml" >&2
  exit "$RC"
fi

LOG=$(mktemp /tmp/verify-rerun-XXXXXX.txt)
{
  echo "Deterministic re-run of the pinned gate for $CLAIM"
  echo "executed_by_uid: $ME ($VERIFIER)"
  echo "claim_author_uid: $AUTHOR_UID"
  echo "verify_cmd: $CMD"
  echo "exit_code: $RC"
  echo "run_at: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "--- output ---"
  printf '%s\n' "$OUT"
} > "$LOG"

if [ "$RC" -eq 0 ]; then
  echo "VERDICT: gate passed under uid $ME"
  "$REPO/operator" evidence-attach "$LOG" \
    --claim "$CLAIM" --task "$TASK" --type test_output \
    --by "$VERIFIER" --verified-by "$VERIFIER" --status verified \
    --verify-cmd "$CMD" \
    --verdict "Deterministic re-run of the pinned gate by uid $ME ($VERIFIER), distinct from claim author uid $AUTHOR_UID. Command exited 0." \
    --notes "Re-run with no model and no credentials; verdict is the process exit code."
else
  # A failed gate is recorded, but NOT as a refutation. One re-run can fail for
  # reasons that are not the claim being false (flaky test, environment). Marking
  # a claim false is a judgment, and judgment stays with a human -- the same
  # reason doctor never executes a stored verification_command.
  echo "VERDICT: gate FAILED under uid $ME (exit $RC)"
  echo "Attaching as DRAFT evidence, not marking the claim false."
  "$REPO/operator" evidence-attach "$LOG" \
    --claim "$CLAIM" --task "$TASK" --type test_output \
    --by "$VERIFIER" --verify-cmd "$CMD" \
    --notes "Pinned gate FAILED (exit $RC) on re-run by uid $ME. Draft evidence: a single failed re-run is not a refutation."
fi
rm -f "$LOG"
exit "$RC"
