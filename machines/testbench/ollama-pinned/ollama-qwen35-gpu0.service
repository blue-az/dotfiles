[Unit]
Description=GPU0-only Ollama for Qwen3.6 35B 192K
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Environment=OLLAMA_HOST=127.0.0.1:18672
Environment=OLLAMA_MODELS=/home/eftb/.ollama/models
Environment=OLLAMA_LIBRARY_PATH=/home/eftb/.local/opt/ollama/lib/ollama
Environment=CUDA_VISIBLE_DEVICES=GPU-22b9dafe-e97d-dbb2-50ba-2f1f1dea61f9
Environment=GGML_VK_VISIBLE_DEVICES=
Environment=OLLAMA_VULKAN=false
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_FLASH_ATTENTION=1
Environment=OLLAMA_KV_CACHE_TYPE=f16
Environment=OLLAMA_CONTEXT_LENGTH=196608
Environment=OLLAMA_KEEP_ALIVE=5m
ExecStart=/home/eftb/.local/opt/ollama/bin/ollama serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
