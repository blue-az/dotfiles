# Machine-specific configs (use templates instead)
# These are per-machine pointer symlinks created by the `ln -sf` steps in
# machines/<name>/AGENTS.md. They must stay untracked: committing one makes
# every other machine adopt this machine's overrides on its next pull.
sway/.config/sway/config.d/outputs.conf
sway/.config/sway/config.d/machine.conf
.aider*
openai/.config/openai/.env
machines/desktop/*.private.asc
.nvimlog
gemini/
openai/
.codex
.claude/*.tmp.*
*.bak.*
# Scratch space — nothing here should ever be committed
temp/
