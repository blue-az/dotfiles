// Swap Caps Lock and Super keys
partial modifier_keys
xkb_symbols "swap_caps_super" {
    key <CAPS> { [ Super_L ] };
    key <LWIN> { [ Caps_Lock ] };
    key <RWIN> { [ Caps_Lock ] };
    modifier_map Mod4 { <CAPS> };
    modifier_map Lock { <LWIN>, <RWIN> };
};

// Shift+\\ is a dead diaeresis; unshifted \\ remains a normal backslash.
// This lets Shift+\\ followed by a/o/u type ä/ö/ü directly.
partial alphanumeric_keys
xkb_symbols "compose_shift_backslash" {
    key <BKSL> {
        type[Group1] = "TWO_LEVEL",
        symbols[Group1] = [ backslash, dead_diaeresis ]
    };
};

