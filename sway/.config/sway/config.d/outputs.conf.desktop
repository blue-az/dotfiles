# Fedora Desktop - Multi-monitor setup
# Copy to outputs.conf on this machine

# Display configuration - boot default is the 2s layout (left Acer + main Acer).
# Both TVs must be disabled explicitly: any connector not named here gets
# auto-placed by sway at scale 1, which parks the 4K TV to the right of main.
# Switch layouts after login with the 1s/2s/3s/3sp/4s aliases.
output DP-1 disable
output HDMI-A-1 disable
output DP-3 pos 0 390 res 1680x1050
output DP-2 pos 1680 0 mode 2560x1440@60Hz

# Workspace assignments - sway picks the first output in the list that is
# active, so these hold up in the layouts where the TVs are switched off.
workspace 1 output DP-2
workspace 2 output DP-3
workspace 3 output DP-1 DP-2
workspace 4 output DP-1 DP-2
workspace 6 output HDMI-A-1 DP-2

