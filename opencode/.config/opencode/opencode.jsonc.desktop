{
  "$schema": "https://opencode.ai/config.json",

  // DESKTOP variant. Machine-specific: `~/.config/opencode/opencode.jsonc` is a
  // machine-local symlink to this file (or to opencode.jsonc.z13-amd), the same
  // pattern sway uses for config.d/machine.conf. Do not stow opencode.jsonc
  // itself.
  //
  // 2026-09-25: the model list mirrors Pi's local models (~/.pi/agent/models.json:
  // same providers, ports, model IDs and names). Pi's cloud models (openai-codex,
  // xai) are not listed; they need `opencode auth login`. The previous 16-tag
  // Ollama list is in git history (cf16b8e).
  //
  // No per-model "temperature" key: OpenCode then sends no temperature, so each
  // Modelfile's baked value applies (all five bake temperature 0.8 and num_ctx,
  // matching Pi's samplingParams). limit.context matches the baked num_ctx.
  "model": "ollama/gemma4-26b-e9pin-ctx16384-t0p8:latest",

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (desktop)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "gemma4-26b-e9pin-ctx16384-t0p8:latest": {
          "name": "Gemma4 26B E9 (desktop)",
          "limit": { "context": 16384, "output": 4096 }
        }
      }
    },
    "testbench-gpu1": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Testbench GPU 1",
      "options": {
        "baseURL": "http://127.0.0.1:11443/v1"
      },
      "models": {
        "qwen3.6-35b-interactive-ctx32768:latest": {
          "name": "Qwen3.6 35B Interactive 32K (Testbench GPU 1)",
          "limit": { "context": 32768, "output": 4096 }
        }
      }
    },
    "testbench": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Testbench GPU 0",
      "options": {
        "baseURL": "http://127.0.0.1:11442/v1"
      },
      "models": {
        "qwen3.6-35b-interactive-ctx32768:latest": {
          "name": "Qwen3.6 35B Interactive 32K (Testbench GPU 0)",
          "limit": { "context": 32768, "output": 4096 }
        },
        "qwen3.8-27b-e9pin-ctx16384-t0p8:latest": {
          "name": "Qwen3.8 27B E9 (Testbench)",
          "limit": { "context": 16384, "output": 4096 }
        },
        "gemma4-26b-e9pin-ctx16384-t0p8:latest": {
          "name": "Gemma4 26B E9 (Testbench)",
          "limit": { "context": 16384, "output": 4096 }
        }
      }
    }
  }
}
